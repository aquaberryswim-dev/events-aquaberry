---
layout: layouts/base.njk
permalink: /
bodyClass: page-home
metaTitle: AquaBerry Events
---
{#- Intro text is editable in the CMS under "Page text". -#}
<section class="hero">
  <img class="hero-flower" src="/assets/brand/aquaberry-flower-pink.svg" alt="" width="420" height="418">
  <div class="wrap hero-inner">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ home.eyebrow }}</p>
    <h1 class="display">{{ home.headline | emphasize | safe }}</h1>
    <p class="lede">{{ home.intro }}</p>
  </div>
</section>

<section class="section" aria-labelledby="upcoming-title">
  <div class="wrap">
    <h2 id="upcoming-title" class="section-title"><span class="dot" aria-hidden="true"></span>Upcoming</h2>
    <ol class="event-list" data-list="upcoming">
      {#- asyncEach (not for): the card includes async image shortcodes, which Nunjucks drops inside a plain for loop. -#}
      {%- asyncEach event in collections.events %}
        {%- set when = "upcoming" %}
        {% include "partials/event-card.njk" %}
      {%- endeach %}
    </ol>
    <p class="empty-note" data-empty-for="upcoming"{% if (collections.events | upcomingOnly).length %} hidden{% endif %}>{{ home.empty_upcoming }}</p>
  </div>
</section>

<section class="section section--past" aria-labelledby="past-title">
  <div class="wrap">
    <h2 id="past-title" class="section-title"><span class="dot" aria-hidden="true"></span>Past events</h2>
    <ol class="past-grid" data-list="past">
      {%- asyncEach event in collections.events | newestFirst %}
        {%- set when = "past" %}
        {% include "partials/event-card.njk" %}
      {%- endeach %}
    </ol>
    <p class="empty-note" data-empty-for="past"{% if (collections.events | pastOnly).length %} hidden{% endif %}>Photos from our events will land here.</p>
  </div>
</section>
